[
  {
    "_id": "{{@ system @}}-{{@ payload_name @}}s-all",
    "namespaced_identifiers": false,
    "source": {
      "operation": "{{@ payload_name @}}s-list",
      "supports_since": true,
      "system": "{{@ system @}}",
      "type": "rest"
    },
    "type": "pipe"
  },
  {
    "_id": "{{@ system @}}-{{@ payload_name @}}s-collect",
    "exclude_completeness": [
      "{{@ system @}}-{{@ payload_name @}}s-share"
    ],
    "namespaced_identifiers": false,
    "source": {
      "dataset": "{{@ system @}}-{{@ payload_name @}}s-all",
      "type": "dataset"
    },
    "transform": [
      {
        "properties": {
          "primary_key": "id",
          "share_dataset": "{{@ system @}}-{{@ payload_name @}}s-share"
        },
        "template": "transform-collect-rest",
        "type": "template"
      },
      {
        "rules": {
          "default": [
            [
              "copy",
              "*"
            ],
            [
              "add",
              "$last-modified",
              [
                "datetime-parse",
                "%Y-%m-%dT%H:%M:%SZ",
                "_S.updated_at"
              ]
            ]
          ]
        },
        "type": "dtl"
      }
    ],
    "type": "pipe"
  },
  {
    "_id": "{{@ system @}}-{{@ payload_name @}}s-share",
    "add_namespaces": false,
    "batch_size": 1,
    "compaction": {
      "keep_versions": 100
    },
    "exclude_completeness": [
      "{{@ system @}}-{{@ payload_name @}}s-share"
    ],
    "namespaced_identifiers": false,
    "sink": {
      "deletion_tracking": false,
      "set_initial_offset": "onload"
    },
    "source": {
      "dataset": "{{@ system @}}-{{@ payload_name @}}s-transform",
      "type": "dataset"
    },
    "transform": [
      {
        "rules": {
          "change_based_on": [
            [
              "copy",
              "*",
              [
                "list",
                "purchase_ledger_account",
                "sales_ledger_account"
              ]
            ]
          ],
          "default": [
            [
              "copy",
              "*",
              [
                "list",
                "$based_on_properties",
                "$based_on",
                "sales_ledger_account",
                "purchase_ledger_account"
              ]
            ],
            [
              "add",
              "sales_ledger_account_id",
              "_S.sales_ledger_account.id"
            ],
            [
              "add",
              "purchase_ledger_account_id",
              "_S.purchase_ledger_account.id"
            ],
            [
              "add",
              "$payload",
              [
                "dict",
                "{{@ payload_name @}}",
                [
                  "apply",
                  "filter_properties",
                  "_T."
                ]
              ]
            ],
            [
              "add",
              "$based_on",
              [
                "apply",
                "change_based_on",
                "_S.$based_on"
              ]
            ],
            [
              "add",
              "$based_on_properties",
              [
                "map",
                "_.",
                [
                  "filter",
                  [
                    "and",
                    [
                      "neq",
                      "sales_ledger_account.id",
                      "_."
                    ],
                    [
                      "neq",
                      "purchase_ledger_account.id",
                      "_."
                    ]
                  ],
                  "_S.$based_on_properties"
                ]
              ]
            ]
          ],
          "filter_properties": [
            [
              "copy",
              "*",
              [
                "list",
                "_*",
                "$*"
              ]
            ]
          ]
        },
        "type": "dtl"
      },
      {
        "properties": {
          "operation_delete": "{{@ payload_name @}}s-delete",
          "operation_insert": "{{@ payload_name @}}s-insert",
          "operation_lookup": "{{@ payload_name @}}s-lookup",
          "operation_update": "{{@ payload_name @}}s-update",
          "primary_key": "id",
          "rest_system": "{{@ system @}}",
          "share_dataset": "{{@ system @}}-{{@ payload_name @}}s-share"
        },
        "template": "transform-share-rest",
        "type": "template"
      }
    ],
    "type": "pipe"
  }
]