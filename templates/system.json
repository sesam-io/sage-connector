{
  "_id": "{{@ system @}}",
  "headers": {
    "Content-Type": "application/json"
  },
  "oauth2": {
    "access_token": "$SECRET(oauth_access_token)",
    "client_id": "$SECRET(oauth_client_id)",
    "client_secret": "$SECRET(oauth_client_secret)",
    "refresh_token": "$SECRET(oauth_refresh_token)",
    "refresh_window": -10,
    "token_url": "{{@ token_url @}}"
  },
  "operations": {
    "addressRegions-list": {
      "id_expression": "{{ id }}",
      "method": "GET",
      "next_page_link": "{{ body['$next'] }}",
      "next_page_termination_strategy": [
        "next-page-link-empty"
      ],
      "page_size": 100,
      "payload_property": "$items",
      "url": "/address_regions?attributes=all&items_per_page={{ page_size }}"
    },
    "addresses-delete": {
      "method": "DELETE",
      "url": "addresses/{{ entity.id }}"
    },
    "addresses-insert": {
      "method": "POST",
      "url": "/addresses"
    },
    "addresses-list": {
      "id_expression": "{{ id }}",
      "method": "GET",
      "next_page_link": "{{ body['$next'] }}",
      "next_page_termination_strategy": [
        "next-page-link-empty"
      ],
      "page_size": 100,
      "payload_property": "$items",
      "since_property_name": "updated_or_created_since",
      "updated_expression": "{{ updated_at }}",
      "url": "/addresses?attributes=all&items_per_page={{ page_size }}"
    },
    "addresses-lookup": {
      "method": "GET",
      "url": "/addresses/{{ entity.id }}"
    },
    "addresses-update": {
      "method": "PUT",
      "url": "/addresses/{{ entity.id }}"
    },
    "businesses-list": {
      "id_expression": "{{ id }}",
