[
  {
    "_id": "{{@ system @}}-{{@ endpoint @}}-all",
    "namespaced_identifiers": false,
    "source": {
      "operation": "{{@ endpoint @}}-list",
      "supports_since": true,
      "system": "{{@ system @}}",
      "type": "rest"
    },
    "type": "pipe"
  },
  {
    "_id": "{{@ system @}}-{{@ endpoint @}}-collect",
    "exclude_completeness": [
      "{{@ system @}}-{{@ endpoint @}}-share"
    ],
    "namespaced_identifiers": false,
    "source": {
      "dataset": "{{@ system @}}-{{@ endpoint @}}-all",
      "type": "dataset"
    },
    "transform": [
      {
        "properties": {
          "primary_key": "id",
          "share_dataset": "{{@ system @}}-{{@ endpoint @}}-share"
        },
        "template": "transform-collect-rest",
        "type": "template"
      },
      {
        "rules": {
          "default": [
            [
              "copy",
              "*"
            ],
            [
              "add",
              "$last-modified",
              [
                "datetime-parse",
                "%Y-%m-%dT%H:%M:%SZ",
                "_S.updated_at"
              ]
            ]
          ]
        },
        "type": "dtl"
      }
    ],
    "type": "pipe"
  },
  {
    "_id": "{{@ system @}}-{{@ endpoint @}}-share",
    "add_namespaces": false,
    "batch_size": 1,
    "compaction": {
      "keep_versions": 100
    },
    "exclude_completeness": [
      "{{@ system @}}-{{@ endpoint @}}-share"
    ],
    "namespaced_identifiers": false,
    "sink": {
      "deletion_tracking": false,
      "set_initial_offset": "onload"
    },
    "source": {
      "dataset": "{{@ system @}}-{{@ endpoint @}}-transform",
      "type": "dataset"
    },
    "transform": [
      {
        "properties": {
          "operation_delete": "{{@ endpoint @}}-delete",
          "operation_insert": "{{@ endpoint @}}-insert",
          "operation_lookup": "{{@ endpoint @}}-lookup",
          "operation_update": "{{@ endpoint @}}-update",
          "primary_key": "id",
          "rest_system": "{{@ system @}}",
          "rewrite_rules_payload": {
            "filter_properties": [
              [
                "copy",
                "*",
                [
                  "list",
                  "_*",
                  "$*",
                  "contact_types"
                ]
              ]
            ],
            "find_contact_type_ids": [
              [
                "merge",
                "_S.contact_types.id"
              ]
            ],
            "rewrite_insert_payload": [
              [
                "merge",
                [
                  "apply",
                  "filter_properties",
                  "_S."
                ]
              ],
              [
                "add",
                "{{@ endpoint @}}_type_ids",
                [
                  "list",
                  "CUSTOMER"
                ]
              ],
              [
                "add",
                "$payload",
                "_T."
              ]
            ],
            "rewrite_update_payload": [
              [
                "merge",
                [
                  "apply",
                  "filter_properties",
                  "_S.$source"
                ]
              ],
              [
                "merge",
                [
                  "dict",
                  "{{@ endpoint @}}_type_ids",
                  [
                    "list",
                    [
                      "first",
                      "_S.response_body.{{@ endpoint @}}_types.id"
                    ]
                  ]
                ]
              ],
              [
                "add",
                "$payload",
                "_T."
              ]
            ]
          },
          "share_dataset": "{{@ system @}}-{{@ endpoint @}}-share"
        },
        "template": "transform-share-rest",
        "type": "template"
      }
    ],
    "type": "pipe"
  }
]